<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AvaloniaVersion>12.1.1</AvaloniaVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>AvaloniaFramework</RootNamespace>
    <AssemblyName>AvaloniaFramework</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>AvaloniaFramework</PackageId>
    <Version>1.0.0</Version>
    <Authors>Sebastian Ortiz</Authors>
    <Description>
      A small MVP/navigation framework for Avalonia: a dependency-injection container,
      a presenter lifecycle, a navigation controller, and a handful of styled controls.
    </Description>
    <PackageTags>avalonia;mvp;navigation;dependency-injection;controls</PackageTags>
    <RepositoryUrl>https://github.com/SebastianOrtiz/AvaloniaFramework</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Hosting\ShellView.axaml.cs">
      <DependentUpon>ShellView.axaml</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
