<UserControl
    IsVisible="{Binding #Root.IsOpen}"
    x:Class="AvaloniaFramework.Controls.Overlays.VReportPreview"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:imaging="using:AvaloniaFramework.Imaging"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Bindings target the control's own properties through #Root rather than the ambient
        DataContext, the same as VPhotoViewer. Colours, fonts, the icon and both action captions
        arrive as V* properties — see the class remarks.
    -->
    <Border Background="{Binding #Root.VScrim}">
        <Grid RowDefinitions="Auto,*,Auto">

            <!--  Dismissing is the cross, not the scrim: the actions below are the point of the screen.  -->
            <Border
                Background="{Binding #Root.VSurface}"
                BorderBrush="{Binding #Root.VStroke}"
                BorderThickness="1"
                CornerRadius="35"
                Grid.Row="0"
                HorizontalAlignment="Right"
                Margin="35,35,35,0">
                <Button
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding #Root.CloseCommand}"
                    Height="70"
                    Padding="0"
                    Width="70">
                    <Viewbox
                        Height="32"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="32">
                        <Path
                            Data="{Binding #Root.VCloseIcon}"
                            Stretch="Uniform"
                            Stroke="{Binding #Root.VInk}"
                            StrokeJoin="Round"
                            StrokeLineCap="Round"
                            StrokeThickness="2" />
                    </Viewbox>
                </Button>
            </Border>

            <!--
                Uniform: the whole page has to be legible at a glance, so it is fitted rather than
                cropped. Decoded at full size — a rendered document is text, and a downscale would
                make the figures being checked unreadable.
            -->
            <Border
                Background="{Binding #Root.VSurface}"
                CornerRadius="21"
                Grid.Row="1"
                Margin="35,21,35,21">
                <Image
                    imaging:ImageLoader.DecodeWidth="0"
                    imaging:ImageLoader.Path="{Binding #Root.ImagePath}"
                    Margin="14"
                    Stretch="Uniform" />
            </Border>

            <StackPanel Grid.Row="2" Margin="35,0,35,70">
                <TextBlock
                    FontFamily="{Binding #Root.VFontFamily}"
                    FontSize="{Binding #Root.VMessageFontSize}"
                    Foreground="{Binding #Root.VInk}"
                    HorizontalAlignment="Center"
                    IsVisible="{Binding #Root.HasMessage}"
                    Margin="0,0,0,21"
                    Text="{Binding #Root.Message}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />

                <!--
                    Sharing leads: sending the document is the common errand, and it needs no file
                    kept anywhere. It is hidden where the platform has no share sheet, so saving
                    becomes the only action rather than sitting beside a dead button.
                -->
                <Border
                    Background="{Binding #Root.VSurface}"
                    BorderBrush="{Binding #Root.VStroke}"
                    BorderThickness="1"
                    CornerRadius="21">
                    <StackPanel>
                        <Button
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding #Root.ShareCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            IsVisible="{Binding #Root.CanShare}"
                            Padding="0">
                            <TextBlock
                                FontFamily="{Binding #Root.VFontFamily}"
                                FontSize="{Binding #Root.VActionFontSize}"
                                FontWeight="SemiBold"
                                Foreground="{Binding #Root.VInk}"
                                Margin="28,21"
                                Text="{Binding #Root.VShareText}"
                                VerticalAlignment="Center" />
                        </Button>

                        <Border
                            Background="{Binding #Root.VRule}"
                            Height="1"
                            IsVisible="{Binding #Root.CanShare}" />

                        <Button
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding #Root.SaveCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="0">
                            <TextBlock
                                FontFamily="{Binding #Root.VFontFamily}"
                                FontSize="{Binding #Root.VActionFontSize}"
                                Foreground="{Binding #Root.VInk}"
                                Margin="28,21"
                                Text="{Binding #Root.VSaveText}"
                                VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>