<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:buttons="clr-namespace:AvaloniaFramework.Apresentacao.Buttons"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border
            Background="BurlyWood"
            Height="500"
            Width="500">
            <Decorator.Resources>
                <DrawingImage x:Key="BoxIcons.RegularPencil">
                    <GeometryDrawing Brush="{DynamicResource SystemControlHighlightBaseHighBrush}" Geometry="F1M640.127990722656,-643.669982910156L251.988998413086,-255.531005859375 251.990005493164,-255.531005859375 229.419006347656,-165.333999633789 319.615997314453,-187.861999511719 707.796997070313,-576.0009765625 640.127990722656,-643.669982910156z M768.127990722656,-771.669006347656L700.458984375,-704 768.127990722656,-636.330993652344 835.796997070313,-704 768.127990722656,-771.669006347656z M768.128479003906,-856.192016601563C790.229736328125,-856.192016601563,812.330993652344,-848.127990722656,828.458984375,-832L896.127990722656,-764.330993652344C912.255981445313,-748.203002929688 921.130981445313,-726.783996582031 921.130981445313,-704 921.130981445313,-681.216003417969 912.255981445313,-659.796997070313 896.127990722656,-643.669006347656L371.627014160156,-119.167999267578C366.165985107422,-113.707000732422,359.295989990234,-109.823997497559,351.786987304688,-107.946990966797L181.119995117188,-65.2799987792969C177.707000732422,-64.427001953125,174.251007080078,-64,170.794998168945,-63.9999961853027L170.794998168945,-64.0009994506836C159.617004394531,-64.0009994506836 148.694000244141,-68.3949966430664 140.630004882813,-76.5019912719727 130.04899597168,-87.1259994506836 125.73999786377,-102.486000061035 129.408996582031,-117.035011291504L172.07600402832,-287.701995849609C173.953002929688,-295.167999267578,177.835998535156,-302.037994384766,183.296997070313,-307.498992919922L707.797973632813,-832C723.926025390625,-848.127990722656,746.027221679688,-856.192016601563,768.128479003906,-856.192016601563z" />
                </DrawingImage>
            </Decorator.Resources>
            <Grid>
                <buttons:ButtonContentExpander ExpandDirection="ToRight" OpenLength="300">
                    <Button>
                        <Image Source="{DynamicResource BoxIcons.RegularPencil}" Stretch="Uniform" />
                    </Button>
                    <Button />
                    <Button />
                </buttons:ButtonContentExpander>
            </Grid>
        </Border>
    </Design.PreviewWith>

    <!--  Toggle button stuff  -->
    <Style Selector="ToggleButton#PART_Button">
        <Setter Property="FocusAdorner" Value="{x:Null}" />

        <Style Selector="^:unchecked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{Binding CbBackgroundUnchecked, RelativeSource={RelativeSource AncestorType=buttons:ButtonContentExpander}}" />
            <Setter Property="BorderBrush" Value="{Binding CbBackgroundUnchecked, RelativeSource={RelativeSource AncestorType=buttons:ButtonContentExpander}}" />
            <Setter Property="Content">
                <Setter.Value>
                    <Template>
                        <PathIcon
                            Data="{Binding CbUncheckedIcon, RelativeSource={RelativeSource AncestorType=buttons:ButtonContentExpander}}"
                            Foreground="{Binding CbUncheckedIconForeground, RelativeSource={RelativeSource AncestorType=buttons:ButtonContentExpander}}"
                            Height="56"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Width="56" />
                    </Template>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="^:checked  /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{Binding CbBackgroundChecked, RelativeSource={RelativeSource AncestorType=buttons:ButtonContentExpander}}" />
            <Setter Property="BorderBrush" Value="{Binding CbBorderBrushChecked, RelativeSource={RelativeSource AncestorType=buttons:ButtonContentExpander}}" />
            <Setter Property="Content">
                <Setter.Value>
                    <Template>
                        <PathIcon
                            Data="{Binding CbCheckedIcon, RelativeSource={RelativeSource AncestorType=buttons:ButtonContentExpander}}"
                            Foreground="{Binding CbCheckedIconForeground, RelativeSource={RelativeSource AncestorType=buttons:ButtonContentExpander}}"
                            Height="56"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Width="56" />
                    </Template>
                </Setter.Value>
            </Setter>
        </Style>
    </Style>

    <!--  Definicao de Botao  -->
    <Style Selector="buttons|ButtonContentExpander">
        <Setter Property="ExpandDirection" Value="ToRight" />
        <Setter Property="IsExpanded" Value="False" />
        <Setter Property="CbUncheckedIcon" Value="{Binding CbCheckedIcon, RelativeSource={RelativeSource AncestorType=buttons:ButtonContentExpander}}" />
        <Setter Property="IconMargin" Value="0" />
        <Setter Property="HorizontalIconAlignment" Value="Center" />
        <Setter Property="VerticalIconAlignment" Value="Center" />
    </Style>



    <!--  ToTop padrao  -->
    <Style Selector="buttons|ButtonContentExpander[ExpandDirection=ToTop]">
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel
                    Background="Transparent"
                    HorizontalAlignment="Stretch"
                    Orientation="Vertical"
                    VerticalAlignment="Bottom" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel
                    Background="Transparent"
                    HorizontalAlignment="Stretch"
                    Name="PART_ExpanderGrid"
                    VerticalAlignment="Bottom">

                    <ToggleButton
                        BorderThickness="0"
                        Command="{TemplateBinding Command}"
                        CornerRadius="0"
                        DockPanel.Dock="Bottom"
                        Height="110"
                        HorizontalAlignment="Stretch"
                        IsChecked="{TemplateBinding IsExpanded,
                                                    Mode=TwoWay}"
                        Name="PART_Button"
                        VerticalAlignment="Stretch"
                        Width="110" />

                    <ItemsPresenter
                        HorizontalAlignment="Stretch"
                        ItemsPanel="{TemplateBinding ItemsPanel}"
                        Name="PART_ItemsPresenter"
                        RenderTransformOrigin="0,0"
                        VerticalAlignment="Stretch" />
                </DockPanel>
            </ControlTemplate>
        </Setter>
    </Style>


    <!--  ToRigth padrao  -->
    <Style Selector="buttons|ButtonContentExpander[ExpandDirection=ToRight]">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel
                    Background="Transparent"
                    HorizontalAlignment="Stretch"
                    Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid
                    Background="#B2000000"
                    ColumnDefinitions="110,Auto"
                    Height="110"
                    Name="PART_UniformGrid"
                    RowDefinitions="110">
                    <Border
                        BorderBrush="#9DFDFF"
                        BorderThickness="0,0,0,2"
                        Grid.ColumnSpan="2" />

                    <ToggleButton
                        BorderThickness="0"
                        Command="{TemplateBinding Command}"
                        CornerRadius="0"
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        IsChecked="{TemplateBinding IsExpanded,
                                                    Mode=TwoWay}"
                        Name="PART_Button"
                        VerticalAlignment="Stretch" />
                    <ItemsPresenter
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        ItemsPanel="{TemplateBinding ItemsPanel}"
                        Name="PART_ItemsPresenter"
                        VerticalAlignment="Stretch" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>
