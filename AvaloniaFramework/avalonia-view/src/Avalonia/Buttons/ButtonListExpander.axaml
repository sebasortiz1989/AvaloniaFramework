                VButtonNormalBackground="Red"
                VButtonPointeroverBackground="Blue"
                VButtonPressedBackground="Blue"
                VButtonWidth="50"
                Width="1440">
                <buttons:ButtonListExpander.Pane>
                    <TextBlock Text="asdasd" />
                </buttons:ButtonListExpander.Pane>
                <buttons:ButtonListExpander.Content>
                    <Panel Background="Aquamarine" />
                </buttons:ButtonListExpander.Content>
            </buttons:ButtonListExpander>

            <!--  Borda separatoria da tela  -->
            <Border
                Background="Red"
                Height="1"
                HorizontalAlignment="Stretch" />

            <!--  Exemplo da direita  -->
            <buttons:ButtonListExpander
                CompactPaneLength="0"
                DisplayMode="CompactInline"
                Height="512"
                IsPaneOpen="False"
                OpenPaneLength="320"
                PanePlacement="Right"
                VButtonHeight="50"
                VButtonHorizontalAlignment="Right"
                VButtonIcon="{DynamicResource chevronLeft}"
                VButtonIconForeground="Black"
                VButtonIconForegroundOpened="Black"
                VButtonIconHeight="12"
                VButtonIconOpened="{DynamicResource chevronRight}"
                VButtonIconWidth="12"
                VButtonNormalBackground="Red"
                VButtonPointeroverBackground="Blue"
                VButtonPressedBackground="Blue"
                VButtonWidth="50"
                Width="1440">
                <buttons:ButtonListExpander.Pane>
                    <TextBlock Text="asdasd" />
                </buttons:ButtonListExpander.Pane>
                <buttons:ButtonListExpander.Content>
                    <Panel Background="Aquamarine" />
                </buttons:ButtonListExpander.Content>
            </buttons:ButtonListExpander>
        </StackPanel>
    </Design.PreviewWith>

