<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:controls="using:AvaloniaFramework.Apresentacao.Buttons"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <StreamGeometry x:Key="default_Image">
            M7 12C7.55228 12 8 11.5523 8 11C8 10.4477 7.55228 10 7 10C6.44772 10 6 10.4477 6 11C6 11.5523 6.44772 12 7 12Z M11 11C11 11.5523 10.5523 12 10 12C9.44772 12 9 11.5523 9 11C9 10.4477 9.44772 10 10 10C10.5523 10 11 10.4477 11 11Z M13 12C13.5523 12 14 11.5523 14 11C14 10.4477 13.5523 10 13 10C12.4477 10 12 10.4477 12 11C12 11.5523 12.4477 12 13 12Z M3 5.5C3 4.11929 4.11929 3 5.5 3H14.5C15.8807 3 17 4.11929 17 5.5V14.5C17 15.8807 15.8807 17 14.5 17H5.5C4.11929 17 3 15.8807 3 14.5V5.5ZM5.5 4C4.67157 4 4 4.67157 4 5.5V14.5C4 15.3284 4.67157 16 5.5 16H14.5C15.3284 16 16 15.3284 16 14.5V7H9.5C8.67157 7 8 6.32843 8 5.5V4H5.5ZM16 5.5C16 4.67157 15.3284 4 14.5 4H9V5.5C9 5.77614 9.22386 6 9.5 6H16V5.5Z
        </StreamGeometry>
    </Styles.Resources>

    <Design.PreviewWith>
        <Panel
            Background="Black"
            Height="500"
            Width="500">
            <controls:VTextButtonWithLeftAndRightImage
                HorizontalAlignment="Center"
                Margin="0"
                VFontSize="16"
                VFontWeight="600"
                VLeftImageHeight="20"
                VLeftImageHorizontalAlignment="Left"
                VLeftImageMargin="0,0,10,0"
                VLeftImageVerticalAlignment="Center"
                VLeftImageWidth="20"
                VLeftNormalImage="{DynamicResource default_Image}"
                VLeftPressedImage="{DynamicResource default_Image}"
                VNormalBackground="#5DE4FF"
                VNormalForeground="#000000"
                VPadding="24,16"
                VPressedBackground="Orange"
                VPressedForeground="Red"
                VRightImageHeight="20"
                VRightImageHorizontalAlignment="Right"
                VRightImageMargin="10,0,0,0"
                VRightImageVerticalAlignment="Center"
                VRightImageWidth="20"
                VRightNormalImage="{DynamicResource default_Image}"
                VRightPressedImage="{DynamicResource default_Image}"
                VText="Ocultar"
                VTextHorizontalAlignment="Center"
                VTextVerticalAlignment="Center"
                VerticalAlignment="Center"
                Width="180" />
        </Panel>
    </Design.PreviewWith>

    <Style Selector="controls|VTextButtonWithLeftAndRightImage">
        <Setter Property="Width" Value="{Binding Width, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}" />
        <Setter Property="Height" Value="{Binding Height, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}" />
        <Setter Property="Margin" Value="{Binding Margin, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Button
                    Background="{TemplateBinding VNormalBackground}"
                    BorderBrush="{TemplateBinding VNormalBorderBrush}"
                    BorderThickness="{TemplateBinding VBorderThickness}"
                    Command="{TemplateBinding Command}"
                    CommandParameter="{TemplateBinding CommandParameter}"
                    CornerRadius="{TemplateBinding VCornerRadius}"
                    Foreground="{TemplateBinding VNormalForeground}"
                    HorizontalAlignment="Stretch"
                    Name="MainButton"
                    Padding="{TemplateBinding VPadding}"
                    VerticalAlignment="Stretch">
                    <Grid
                        HorizontalAlignment="Stretch"
                        IsHitTestVisible="False"
                        VerticalAlignment="Stretch">
                        <Image
                            Height="{TemplateBinding VLeftImageHeight}"
                            HorizontalAlignment="{TemplateBinding VLeftImageHorizontalAlignment}"
                            IsHitTestVisible="False"
                            Margin="{TemplateBinding VLeftImageMargin}"
                            VerticalAlignment="{TemplateBinding VLeftImageVerticalAlignment}"
                            Width="{TemplateBinding VLeftImageWidth}" />
                        <TextBlock
                            FontFamily="Roboto"
                            FontSize="{TemplateBinding VFontSize}"
                            FontWeight="{TemplateBinding VFontWeight}"
                            Foreground="{TemplateBinding VNormalForeground}"
                            HorizontalAlignment="{TemplateBinding VTextHorizontalAlignment}"
                            IsHitTestVisible="False"
                            Margin="{TemplateBinding VTextMargin}"
                            Text="{TemplateBinding VText}"
                            TextWrapping="Wrap"
                            VerticalAlignment="{TemplateBinding VTextVerticalAlignment}" />
                        <Image
                            Height="{TemplateBinding VRightImageHeight}"
                            HorizontalAlignment="{TemplateBinding VRightImageHorizontalAlignment}"
                            IsHitTestVisible="False"
                            Margin="{TemplateBinding VRightImageMargin}"
                            VerticalAlignment="{TemplateBinding VRightImageVerticalAlignment}"
                            Width="{TemplateBinding VRightImageWidth}" />
                    </Grid>
                </Button>
            </ControlTemplate>
        </Setter>

        <!--  pressed style  -->
        <Style Selector="^ &gt; Button#MainButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{Binding VPressedBackground, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}" />
            <Setter Property="BorderBrush" Value="{Binding VPressedBackground, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}" />
            <Setter Property="Content">
                <Setter.Value>
                    <Template>
                        <Grid
                            HorizontalAlignment="Stretch"
                            IsHitTestVisible="False"
                            VerticalAlignment="Stretch">
                            <Image
                                Height="{Binding VLeftImageHeight, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}"
                                HorizontalAlignment="{Binding VLeftImageHorizontalAlignment, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}"
                                IsHitTestVisible="False"
                                Margin="{Binding VLeftImageMargin, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}"
                                VerticalAlignment="{Binding VLeftImageVerticalAlignment, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}"
                                Width="{Binding VLeftImageWidth, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}" />
                            <TextBlock
                                FontFamily="Roboto"
                                FontSize="{Binding VFontSize, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}"
                                FontWeight="{Binding VFontWeight, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}"
                                Foreground="{Binding VPressedForeground, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}"
                                HorizontalAlignment="{Binding VTextHorizontalAlignment, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}"
                                IsHitTestVisible="False"
                                Margin="{Binding VTextMargin, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}"
                                Text="{Binding VText, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}"
                                TextWrapping="Wrap"
                                VerticalAlignment="{Binding VTextVerticalAlignment, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}" />
                            <Image
                                Height="{Binding VRightImageHeight, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}"
                                HorizontalAlignment="{Binding VRightImageHorizontalAlignment, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}"
                                IsHitTestVisible="False"
                                Margin="{Binding VRightImageMargin, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}"
                                VerticalAlignment="{Binding VRightImageVerticalAlignment, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}"
                                Width="{Binding VRightImageWidth, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}" />
                        </Grid>
                    </Template>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  pointerover style  -->
        <Style Selector="^ &gt; Button#MainButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{Binding VPressedBackground, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}" />
            <Setter Property="BorderBrush" Value="{Binding VPressedBackground, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}" />
            <Setter Property="Content">
                <Setter.Value>
                    <Template>
                        <Grid
                            HorizontalAlignment="Stretch"
                            IsHitTestVisible="False"
                            VerticalAlignment="Stretch">
                            <Image
                                Height="{Binding VLeftImageHeight, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}"
                                HorizontalAlignment="{Binding VLeftImageHorizontalAlignment, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}"
                                IsHitTestVisible="False"
                                Margin="{Binding VLeftImageMargin, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}"
                                VerticalAlignment="{Binding VLeftImageVerticalAlignment, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}"
                                Width="{Binding VLeftImageWidth, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}" />
                            <TextBlock
                                FontFamily="Roboto"
                                FontSize="{Binding VFontSize, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}"
                                FontWeight="{Binding VFontWeight, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}"
                                Foreground="{Binding VPressedForeground, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}"
                                HorizontalAlignment="{Binding VTextHorizontalAlignment, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}"
                                IsHitTestVisible="False"
                                Margin="{Binding VTextMargin, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}"
                                Text="{Binding VText, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}"
                                TextWrapping="Wrap"
                                VerticalAlignment="{Binding VTextVerticalAlignment, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}" />
                            <Image
                                Height="{Binding VRightImageHeight, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}"
                                HorizontalAlignment="{Binding VRightImageHorizontalAlignment, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}"
                                IsHitTestVisible="False"
                                Margin="{Binding VRightImageMargin, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}"
                                VerticalAlignment="{Binding VRightImageVerticalAlignment, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}"
                                Width="{Binding VRightImageWidth, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}" />
                        </Grid>
                    </Template>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  disabled style  -->
        <Style Selector="^ &gt; Button#MainButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#335DE4FF" />
            <Setter Property="BorderBrush" Value="#335DE4FF" />
            <Setter Property="Content">
                <Setter.Value>
                    <Template>
                        <Grid
                            HorizontalAlignment="Stretch"
                            IsHitTestVisible="False"
                            VerticalAlignment="Stretch">
                            <Image
                                Height="{Binding VLeftImageHeight, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}"
                                HorizontalAlignment="{Binding VLeftImageHorizontalAlignment, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}"
                                IsHitTestVisible="False"
                                Margin="{Binding VLeftImageMargin, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}"
                                VerticalAlignment="{Binding VLeftImageVerticalAlignment, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}"
                                Width="{Binding VLeftImageWidth, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}" />
                            <TextBlock
                                FontFamily="Roboto"
                                FontSize="{Binding VFontSize, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}"
                                FontWeight="{Binding VFontWeight, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}"
                                Foreground="#A7B0B3"
                                HorizontalAlignment="{Binding VTextHorizontalAlignment, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}"
                                IsHitTestVisible="False"
                                Margin="{Binding VTextMargin, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}"
                                Text="{Binding VText, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}"
                                TextWrapping="Wrap"
                                VerticalAlignment="{Binding VTextVerticalAlignment, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}" />
                            <Image
                                Height="{Binding VRightImageHeight, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}"
                                HorizontalAlignment="{Binding VRightImageHorizontalAlignment, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}"
                                IsHitTestVisible="False"
                                Margin="{Binding VRightImageMargin, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}"
                                VerticalAlignment="{Binding VRightImageVerticalAlignment, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}"
                                Width="{Binding VRightImageWidth, RelativeSource={RelativeSource AncestorType=controls:VTextButtonWithLeftAndRightImage}}" />
                        </Grid>
                    </Template>
                </Setter.Value>
            </Setter>
        </Style>
    </Style>
</Styles>
