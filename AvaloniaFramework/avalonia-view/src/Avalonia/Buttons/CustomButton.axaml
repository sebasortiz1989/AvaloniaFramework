                            Height="{TemplateBinding IconHeight}"
                            HorizontalAlignment="{TemplateBinding IconHorizontalAlignment}"
                            IsHitTestVisible="False"
                            Margin="{TemplateBinding VerionIconMargin}"
                            VerticalAlignment="{TemplateBinding IconVerticalAlignment}"
                            Width="{TemplateBinding IconWidth}" />
                        <TextBlock
                            FontFamily="{TemplateBinding TextFontFamily}"
                            FontSize="{TemplateBinding TextSize}"
                            FontWeight="Bold"
                            Foreground="{TemplateBinding TextForeground}"
                            HorizontalAlignment="{TemplateBinding TextHorizontalAlignment}"
                            IsHitTestVisible="False"
                            Margin="{TemplateBinding TextMargin}"
                            Text="{TemplateBinding ButtonText}"
                            TextWrapping="Wrap"
                            VerticalAlignment="{TemplateBinding TextVerticalAlignment}" />
                        <PathIcon
                            Data="{TemplateBinding RightIcon}"
                            Foreground="{TemplateBinding IconForegroundUnchecked}"
                            Height="{TemplateBinding IconHeight}"
                            HorizontalAlignment="{TemplateBinding IconHorizontalAlignment}"
                            IsHitTestVisible="False"
                            Margin="{TemplateBinding VerionIconMargin}"
                            VerticalAlignment="{TemplateBinding IconVerticalAlignment}"
                            Width="{TemplateBinding IconWidth}" />
                    </StackPanel>
                </ToggleButton>
            </ControlTemplate>
        </Setter>
    </Style>

    <!--  LeftIconAndText Button  -->
    <Style Selector="buttons|CustomButton[ButtonContent=LeftIconAndTextButton]">
        <Setter Property="Template">
            <ControlTemplate>
                <Button
                    Background="{TemplateBinding UncheckedBackground}"
                    BorderThickness="{TemplateBinding ToggleBorderThickness}"
                    Command="{TemplateBinding Command}"
                    CornerRadius="{TemplateBinding ToggleButtonCornerRadius}"
                    HorizontalAlignment="{TemplateBinding ToggleHorizontalAlignment}"
                    Padding="{TemplateBinding TogglePadding}"
                    VerticalAlignment="{TemplateBinding ToggleVerticalAlignment}">
                    <StackPanel
                        HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                        IsHitTestVisible="False"
                        Margin="{TemplateBinding Padding}"
                        Orientation="Horizontal"
                        VerticalAlignment="{TemplateBinding VerticalAlignment}">
                        <Image
                            Height="{TemplateBinding ImageHeight}"
                            IsHitTestVisible="False"
                            Margin="{TemplateBinding ImageMargin}"
                            Source="{TemplateBinding SourceImage}"
                            Width="{TemplateBinding ImageWidth}" />
                        <PathIcon
                            Data="{TemplateBinding LeftIcon}"
                            Foreground="{TemplateBinding IconForegroundUnchecked}"
                            Height="{TemplateBinding IconHeight}"
                            HorizontalAlignment="{TemplateBinding IconHorizontalAlignment}"
                            IsHitTestVisible="False"
                            Margin="{TemplateBinding VerionIconMargin}"
                            VerticalAlignment="{TemplateBinding IconVerticalAlignment}"
                            Width="{TemplateBinding IconWidth}" />
                        <TextBlock
                            FontSize="{TemplateBinding TextSize}"
                            Foreground="{TemplateBinding TextForeground}"
                            HorizontalAlignment="{TemplateBinding TextHorizontalAlignment}"
                            IsHitTestVisible="False"
                            Margin="{TemplateBinding TextMargin}"
                            Text="{TemplateBinding ButtonText}"
                            TextWrapping="Wrap"
                            VerticalAlignment="{TemplateBinding TextVerticalAlignment}" />
                    </StackPanel>
                </Button>
            </ControlTemplate>
        </Setter>
    </Style>

    <!--  LeftImageAndText (Imagem com Texto)  -->
    <Style Selector="buttons|CustomButton[ButtonContent=LeftImageAndText]">
        <Setter Property="Template">
            <ControlTemplate>
                <Button
                    Background="{TemplateBinding UncheckedBackground}"
                    BorderThickness="{TemplateBinding ToggleBorderThickness}"
                    Command="{TemplateBinding Command}"
                    CornerRadius="{TemplateBinding ToggleButtonCornerRadius}"
                    HorizontalAlignment="{TemplateBinding ToggleHorizontalAlignment}"
                    Padding="{TemplateBinding TogglePadding}"
                    VerticalAlignment="{TemplateBinding ToggleVerticalAlignment}">
                    <StackPanel
                        HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                        IsHitTestVisible="False"
                        Margin="{TemplateBinding Padding}"
                        Orientation="Horizontal"
                        VerticalAlignment="{TemplateBinding VerticalAlignment}">
                        <Image
                            Height="{TemplateBinding ImageHeight}"
                            IsHitTestVisible="False"
                            Margin="{TemplateBinding ImageMargin}"
                            Source="{TemplateBinding SourceImage}"
                            Width="{TemplateBinding ImageWidth}" />
                        <TextBlock
                            FontSize="{TemplateBinding TextSize}"
                            Foreground="{TemplateBinding TextForeground}"
                            HorizontalAlignment="{TemplateBinding TextHorizontalAlignment}"
                            IsHitTestVisible="False"
                            Margin="{TemplateBinding TextMargin}"
                            Text="{TemplateBinding ButtonText}"
                            TextWrapping="Wrap"
                            VerticalAlignment="{TemplateBinding TextVerticalAlignment}" />
                    </StackPanel>
                </Button>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>
