    <Style Selector="buttons|ButtonListExpander">
        <Setter Property="Template">
            <ControlTemplate>
                <SplitView
                    CompactPaneLength="{TemplateBinding CompactPaneLength}"
                    DisplayMode="{TemplateBinding DisplayMode}"
                    FlowDirection="{TemplateBinding FlowDirection}"
                    Height="{TemplateBinding Height}"
                    HorizontalAlignment="Stretch"
                    IsPaneOpen="{TemplateBinding IsPaneOpen}"
                    OpenPaneLength="{TemplateBinding OpenPaneLength}"
                    Pane="{TemplateBinding Pane}"
                    PanePlacement="{TemplateBinding PanePlacement}"
                    VerticalAlignment="Stretch"
                    Width="{TemplateBinding Width}"
                    x:Name="MainSplitView">

                    <SplitView.Content>
                        <Panel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <!--  Content stuff  -->
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                x:Name="PART_ContentPresenter" />

                            <!--  Expand button  -->
                            <Button
                                Background="{TemplateBinding VButtonNormalBackground}"
                                ClickMode="Release"
                                Height="{TemplateBinding VButtonHeight}"
                                HorizontalAlignment="{TemplateBinding VButtonHorizontalAlignment}"
                                Margin="{TemplateBinding VButtonMargin}"
                                VerticalAlignment="{TemplateBinding VButtonVerticalAlignment}"
                                Width="{TemplateBinding VButtonWidth}"
                                ZIndex="999"
                                x:Name="ExpandButton">
                                <PathIcon
                                    Background="Transparent"
                                    Data="{TemplateBinding VButtonIcon}"
                                    Foreground="{TemplateBinding VButtonIconForeground}"
                                    Height="{TemplateBinding VButtonIconHeight}"
                                    Width="{TemplateBinding VButtonIconWidth}"
                                    x:Name="Chevron" />
                            </Button>
                        </Panel>
                    </SplitView.Content>
                </SplitView>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ Button#ExpandButton:pressed">
            <Style Selector="^ /template/ ContentPresenter">
                <Setter Property="Background" Value="{Binding VButtonPressedBackground, RelativeSource={RelativeSource AncestorType=buttons:ButtonListExpander}}" />
            </Style>

            <Style Selector="^ PathIcon#Chevron">
                <Setter Property="Data" Value="{Binding VButtonIconOpened, RelativeSource={RelativeSource AncestorType=buttons:ButtonListExpander}}" />
                <Setter Property="Foreground" Value="{Binding VButtonIconForegroundOpened, RelativeSource={RelativeSource AncestorType=buttons:ButtonListExpander}}" />
            </Style>
        </Style>

        <Style Selector="^ Button#ExpandButton:pointerover">
            <Style Selector="^ /template/ ContentPresenter">
                <Setter Property="Background" Value="{Binding VButtonPointeroverBackground, RelativeSource={RelativeSource AncestorType=buttons:ButtonListExpander}}" />
            </Style>
        </Style>

