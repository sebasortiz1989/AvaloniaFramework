    <Style Selector="textFields|TextField">
        <!--  Set Defaults  -->
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Background="Transparent"
                    BorderBrush="#9dfdff"
                    BorderThickness="2"
                    CornerRadius="100"
                    MinHeight="86"
                    MinWidth="150">
                    <StackPanel Orientation="Horizontal">
                        <PathIcon
                            Data="{TemplateBinding SvgIconLeft}"
                            Foreground="#9dfdff"
                            HorizontalAlignment="Center"
                            Margin="20,0,0,0"
                            VerticalAlignment="Center"
                            x:Name="IconImage1" />

                        <TextBox
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CaretBrush="#27CCFF"
                            FontSize="32"
                            Foreground="White"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            IsHitTestVisible="{TemplateBinding IsHitTestVisible}"
                            Margin="10,0,10,0"
                            SelectionBrush="#81c5f0"
                            SelectionForegroundBrush="#badefe"
                            Text="{TemplateBinding Text}"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            x:Name="TextBoxField" />

                        <PathIcon
                            Data="{TemplateBinding SvgIconRight}"
                            Foreground="#9dfdff"
                            HorizontalAlignment="Center"
                            Margin="0,0,20,0"
                            VerticalAlignment="Center"
                            x:Name="IconImage2" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

