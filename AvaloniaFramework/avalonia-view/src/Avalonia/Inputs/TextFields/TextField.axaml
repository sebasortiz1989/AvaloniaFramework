    xmlns="https://github.com/avaloniaui"
    xmlns:textFields="clr-namespace:AvaloniaFramework.Apresentacao.Inputs.TextFields"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <textFields:TextField />
    </Design.PreviewWith>
