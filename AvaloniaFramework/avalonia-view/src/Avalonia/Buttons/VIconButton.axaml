<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:controls="using:AvaloniaFramework.Apresentacao.Buttons"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Panel Height="500" Width="500">
            <controls:VIconButton
                Height="90"
                HorizontalAlignment="Center"
                VBorderThickness="0"
                VCornerRadius="100"
                VIconHeight="30"
                VIconMargin="0"
                VIconNormalForeground="#43B6DB"
                VIconPointoverForeground="Red"
                VIconPressedForeground="#323232"
                VIconVerticalAlignment="Center"
                VIconWidth="35"
                VNormalBackground="Red"
                VNormalIcon="M7 12C7.55228 12 8 11.5523 8 11C8 10.4477 7.55228 10 7 10C6.44772 10 6 10.4477 6 11C6 11.5523 6.44772 12 7 12Z M11 11C11 11.5523 10.5523 12 10 12C9.44772 12 9 11.5523 9 11C9 10.4477 9.44772 10 10 10C10.5523 10 11 10.4477 11 11Z M13 12C13.5523 12 14 11.5523 14 11C14 10.4477 13.5523 10 13 10C12.4477 10 12 10.4477 12 11C12 11.5523 12.4477 12 13 12Z M3 5.5C3 4.11929 4.11929 3 5.5 3H14.5C15.8807 3 17 4.11929 17 5.5V14.5C17 15.8807 15.8807 17 14.5 17H5.5C4.11929 17 3 15.8807 3 14.5V5.5ZM5.5 4C4.67157 4 4 4.67157 4 5.5V14.5C4 15.3284 4.67157 16 5.5 16H14.5C15.3284 16 16 15.3284 16 14.5V7H9.5C8.67157 7 8 6.32843 8 5.5V4H5.5ZM16 5.5C16 4.67157 15.3284 4 14.5 4H9V5.5C9 5.77614 9.22386 6 9.5 6H16V5.5Z"
                VPadding="30"
                VPointoverBackground="Green"
                VPointoverBorderBrush="Green"
                VPointoverForeground="Red"
                VPressedBackground="#43B6DB"
                VPressedIcon="M7 12C7.55228 12 8 11.5523 8 11C8 10.4477 7.55228 10 7 10C6.44772 10 6 10.4477 6 11C6 11.5523 6.44772 12 7 12Z M11 11C11 11.5523 10.5523 12 10 12C9.44772 12 9 11.5523 9 11C9 10.4477 9.44772 10 10 10C10.5523 10 11 10.4477 11 11Z M13 12C13.5523 12 14 11.5523 14 11C14 10.4477 13.5523 10 13 10C12.4477 10 12 10.4477 12 11C12 11.5523 12.4477 12 13 12Z M3 5.5C3 4.11929 4.11929 3 5.5 3H14.5C15.8807 3 17 4.11929 17 5.5V14.5C17 15.8807 15.8807 17 14.5 17H5.5C4.11929 17 3 15.8807 3 14.5V5.5ZM5.5 4C4.67157 4 4 4.67157 4 5.5V14.5C4 15.3284 4.67157 16 5.5 16H14.5C15.3284 16 16 15.3284 16 14.5V7H9.5C8.67157 7 8 6.32843 8 5.5V4H5.5ZM16 5.5C16 4.67157 15.3284 4 14.5 4H9V5.5C9 5.77614 9.22386 6 9.5 6H16V5.5Z"
                Width="90" />
        </Panel>
    </Design.PreviewWith>

    <Style Selector="controls|VIconButton">
        <Setter Property="Width" Value="{Binding Width, RelativeSource={RelativeSource AncestorType=controls:VIconButton}}" />
        <Setter Property="Height" Value="{Binding Height, RelativeSource={RelativeSource AncestorType=controls:VIconButton}}" />
        <Setter Property="Margin" Value="{Binding Margin, RelativeSource={RelativeSource AncestorType=controls:VIconButton}}" />

        <Setter Property="Template">
            <ControlTemplate>
                <Button
                    Background="{TemplateBinding VNormalBackground}"
                    BorderBrush="{TemplateBinding VNormalBorderBrush}"
                    BorderThickness="{TemplateBinding VBorderThickness}"
                    Command="{TemplateBinding Command}"
                    CommandParameter="{TemplateBinding CommandParameter}"
                    CornerRadius="{TemplateBinding VCornerRadius}"
                    HorizontalAlignment="Stretch"
                    Name="MainButton"
                    Padding="{TemplateBinding VPadding}"
                    VerticalAlignment="Stretch">
                    <PathIcon
                        Data="{TemplateBinding VNormalIcon}"
                        Foreground="{TemplateBinding VIconNormalForeground}"
                        Height="{TemplateBinding VIconHeight}"
                        HorizontalAlignment="{TemplateBinding VIconHorizontalAlignment}"
                        IsHitTestVisible="False"
                        Margin="{TemplateBinding VIconMargin}"
                        VerticalAlignment="{TemplateBinding VIconVerticalAlignment}"
                        Width="{TemplateBinding VIconWidth}" />
                </Button>
            </ControlTemplate>
        </Setter>

        <!--  pressed style  -->
        <Style Selector="^ &gt; Button#MainButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{Binding VPressedBackground, RelativeSource={RelativeSource AncestorType=controls:VIconButton}}" />
            <Setter Property="BorderBrush" Value="{Binding VPressedBackground, RelativeSource={RelativeSource AncestorType=controls:VIconButton}}" />
            <Setter Property="Content">
                <Setter.Value>
                    <Template>
                        <PathIcon
                            Data="{Binding VPressedIcon, RelativeSource={RelativeSource AncestorType=controls:VIconButton}}"
                            Foreground="{Binding VIconPressedForeground, RelativeSource={RelativeSource AncestorType=controls:VIconButton}}"
                            Height="{Binding VIconHeight, RelativeSource={RelativeSource AncestorType=controls:VIconButton}}"
                            HorizontalAlignment="{Binding VIconHorizontalAlignment, RelativeSource={RelativeSource AncestorType=controls:VIconButton}}"
                            IsHitTestVisible="False"
                            Margin="{Binding VIconMargin, RelativeSource={RelativeSource AncestorType=controls:VIconButton}}"
                            VerticalAlignment="{Binding VIconVerticalAlignment, RelativeSource={RelativeSource AncestorType=controls:VIconButton}}"
                            Width="{Binding VIconWidth, RelativeSource={RelativeSource AncestorType=controls:VIconButton}}" />
                    </Template>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  pointerover style  -->
        <Style Selector="^ &gt; Button#MainButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{Binding VPressedBackground, RelativeSource={RelativeSource AncestorType=controls:VIconButton}}" />
            <Setter Property="BorderBrush" Value="{Binding VPressedBackground, RelativeSource={RelativeSource AncestorType=controls:VIconButton}}" />
            <Setter Property="Content">
                <Setter.Value>
                    <Template>
                        <PathIcon
                            Data="{Binding VPressedIcon, RelativeSource={RelativeSource AncestorType=controls:VIconButton}}"
                            Foreground="{Binding VIconPressedForeground, RelativeSource={RelativeSource AncestorType=controls:VIconButton}}"
                            Height="{Binding VIconHeight, RelativeSource={RelativeSource AncestorType=controls:VIconButton}}"
                            HorizontalAlignment="{Binding VIconHorizontalAlignment, RelativeSource={RelativeSource AncestorType=controls:VIconButton}}"
                            IsHitTestVisible="False"
                            Margin="{Binding VIconMargin, RelativeSource={RelativeSource AncestorType=controls:VIconButton}}"
                            VerticalAlignment="{Binding VIconVerticalAlignment, RelativeSource={RelativeSource AncestorType=controls:VIconButton}}"
                            Width="{Binding VIconWidth, RelativeSource={RelativeSource AncestorType=controls:VIconButton}}" />
                    </Template>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  disabled style  -->
        <Style Selector="^ &gt; Button#MainButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#335DE4FF" />
            <Setter Property="BorderBrush" Value="#335DE4FF" />
            <Setter Property="Content">
                <Setter.Value>
                    <Template>
                        <PathIcon
                            Data="{Binding VPressedIcon, RelativeSource={RelativeSource AncestorType=controls:VIconButton}}"
                            Foreground="#A7B0B3"
                            Height="{Binding VIconHeight, RelativeSource={RelativeSource AncestorType=controls:VIconButton}}"
                            HorizontalAlignment="{Binding VIconHorizontalAlignment, RelativeSource={RelativeSource AncestorType=controls:VIconButton}}"
                            IsHitTestVisible="False"
                            Margin="{Binding VIconMargin, RelativeSource={RelativeSource AncestorType=controls:VIconButton}}"
                            VerticalAlignment="{Binding VIconVerticalAlignment, RelativeSource={RelativeSource AncestorType=controls:VIconButton}}"
                            Width="{Binding VIconWidth, RelativeSource={RelativeSource AncestorType=controls:VIconButton}}" />
                    </Template>
                </Setter.Value>
            </Setter>
        </Style>
    </Style>
</Styles>
