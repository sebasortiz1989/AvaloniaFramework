<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:controls="using:AvaloniaFramework.Apresentacao.Buttons"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Panel Height="500" Width="500">
            <controls:VImageButton
                Height="90"
                HorizontalAlignment="Center"
                VBorderThickness="0"
                VCornerRadius="100"
                VImageHeight="30"
                VImageMargin="0"
                VImageVerticalAlignment="Center"
                VImageWidth="35"
                VNormalBackground="Red"
                VPadding="30"
                VPointoverBackground="Green"
                VPointoverBorderBrush="Green"
                VPointoverForeground="Red"
                VPressedBackground="#43B6DB"
                VSourceImage="avares://AvaloniaFramework/Assets/battery.png"
                Width="90" />
        </Panel>
    </Design.PreviewWith>

    <Style Selector="controls|VImageButton">
        <Setter Property="Width" Value="{Binding Width, RelativeSource={RelativeSource AncestorType=controls:VImageButton}}" />
        <Setter Property="Height" Value="{Binding Height, RelativeSource={RelativeSource AncestorType=controls:VImageButton}}" />
        <Setter Property="Margin" Value="{Binding Margin, RelativeSource={RelativeSource AncestorType=controls:VImageButton}}" />

        <Setter Property="Template">
            <ControlTemplate>
                <Button
                    Background="{TemplateBinding VNormalBackground}"
                    BorderBrush="{TemplateBinding VNormalBorderBrush}"
                    BorderThickness="{TemplateBinding VBorderThickness}"
                    Command="{TemplateBinding Command}"
                    CommandParameter="{TemplateBinding CommandParameter}"
                    CornerRadius="{TemplateBinding VCornerRadius}"
                    HorizontalAlignment="Stretch"
                    Name="MainButton"
                    Padding="{TemplateBinding VPadding}"
                    VerticalAlignment="Stretch">
                    <Image
                        Height="{TemplateBinding VImageHeight}"
                        IsHitTestVisible="False"
                        Margin="{TemplateBinding VImageMargin}"
                        Source="{TemplateBinding VSourceImage}"
                        Width="{TemplateBinding VImageWidth}" />
                </Button>
            </ControlTemplate>
        </Setter>

        <!--  pressed style  -->
        <Style Selector="^ &gt; Button#MainButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{Binding VPressedBackground, RelativeSource={RelativeSource AncestorType=controls:VImageButton}}" />
            <Setter Property="BorderBrush" Value="{Binding VPressedBackground, RelativeSource={RelativeSource AncestorType=controls:VImageButton}}" />
        </Style>

        <!--  pointerover style  -->
        <Style Selector="^ &gt; Button#MainButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{Binding VPressedBackground, RelativeSource={RelativeSource AncestorType=controls:VImageButton}}" />
            <Setter Property="BorderBrush" Value="{Binding VPressedBackground, RelativeSource={RelativeSource AncestorType=controls:VImageButton}}" />
        </Style>

        <!--  disabled style  -->
        <Style Selector="^ &gt; Button#MainButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#335DE4FF" />
            <Setter Property="BorderBrush" Value="#335DE4FF" />
        </Style>
    </Style>
</Styles>
