<Styles
    x:Class="AvaloniaFramework.LayoutStyles"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://AvaloniaFramework/Controls/Buttons/VButton.axaml" />
                <ResourceInclude Source="avares://AvaloniaFramework/Controls/Buttons/GroupButton.axaml" />
                <ResourceInclude Source="avares://AvaloniaFramework/Controls/Inputs/VTextBoxWithLabel.axaml" />
                <ResourceInclude Source="avares://AvaloniaFramework/Controls/Inputs/VSearchableComboBox.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

</Styles>
