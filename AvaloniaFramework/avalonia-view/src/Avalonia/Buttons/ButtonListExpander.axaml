    <Design.PreviewWith>
        <StackPanel Height="1025" Width="1440">

            <!--  Exemplo da esquerda  -->
            <buttons:ButtonListExpander
                CompactPaneLength="0"
                DisplayMode="CompactInline"
                FlowDirection="LeftToRight"
                Height="512"
                IsPaneOpen="False"
                OpenPaneLength="320"
                PanePlacement="Left"
                VButtonHeight="50"
                VButtonHorizontalAlignment="Left"
                VButtonIcon="{DynamicResource chevronRight}"
