        <converters:BackgroundStatusConverter x:Key="BackgroundStatusConverter" />

    </Styles.Resources>

    <Design.PreviewWith>

        <StackPanel
            Width="800"
            Height="300"
            Background="#040404"
            Orientation="Horizontal">
            <controls:VCardInfo
                Margin="0,0,10,0"
                VerticalAlignment="Top"
                VCardBackgroundEnum="Desconectado"
                VCardContentIcon="{StaticResource controladora}"
                VCardContentIconHeight="55"
                VCardContentIconWidth="57"
                VCardContentText="Controladora"
                VCardContentTextMargin="0,33,0,0"
                VCardStatusEllipseHorizontalAlignment="Left"
                VCardStatusEllipseMargin="20,0,8,0"
                VCardStatusEllipseVerticalAlignment="Center"
                VCardStatusText="Desconectado"
                VIsCardContentIconVisible="True" />

            <controls:VCardInfo
                Margin="0,0,10,0"
                VerticalAlignment="Top"
                VCardBackgroundEnum="Conectado"
                VCardBorderBrush="#DBFAA8"
                VCardContentImage="avares://AvaloniaFramework/Assets/volante.png"
                VCardContentImageHeight="60.25"
                VCardContentImageWidth="100.21"
                VCardContentText="Piloto At"
                VCardContentTextMargin="0,33,0,0"
                VCardStatusEllipseBackground="#DBFAA8"
                VCardStatusEllipseHorizontalAlignment="Left"
                VCardStatusEllipseMargin="5,0,8,0"
                VCardStatusEllipseVerticalAlignment="Center"
                VCardStatusText="Conectado"
                VIsCardContentImageVisible="True" />

            <controls:VCardInfo
                Margin="0,0,10,0"
                VerticalAlignment="Top"
                VCardBackgroundEnum="SemCombustivel"
                VCardBorderBrush="#B30910"
                VCardContentIcon="{StaticResource tanque}"
                VCardContentIconHeight="57"
                VCardContentIconWidth="47"
                VCardContentText="Tanque"
                VCardContentTextMargin="0,11,0,0"
                VCardStatusEllipseBackground="#FFC140"
                VCardStatusEllipseHorizontalAlignment="Left"
                VCardStatusEllipseMargin="5,11.18,8,0"
                VCardStatusEllipseVerticalAlignment="Top"
                VCardStatusHorizontalAlignment="Center"
                VCardStatusText="Sem Combustível"
                VIsCardContentIconVisible="True" />

        </StackPanel>

    </Design.PreviewWith>

    <Style Selector="controls|VCardInfo">

        <!--  Set Defaults  -->
        <Setter Property="Template">
            <ControlTemplate>

                <Border
                    x:Name="card"
                    HorizontalAlignment="Center"
                    BorderBrush="{TemplateBinding VCardBorderBrush}"
                    BorderThickness="{TemplateBinding VCardBorderThickness}"
                    CornerRadius="{TemplateBinding VCardCornerRadius}"
                    ZIndex="0">

                    <Border
                        x:Name="cardBackground"
                        Width="{TemplateBinding VCardWidth}"
                        Height="{TemplateBinding VCardHeight}"
                        Padding="{TemplateBinding VCardPadding}"
                        Background="{TemplateBinding VCardBackgroundEnum,
                                                     Converter={StaticResource BackgroundStatusConverter}}"
                        CornerRadius="13.6"
                        Opacity="{TemplateBinding VCardBackgroundOpacity}">
                        <Grid Opacity="10">

                            <!--  Content icon  -->
                            <PathIcon
                                x:Name="contentIcon"
                                Width="{TemplateBinding VCardContentIconWidth}"
                                Height="{TemplateBinding VCardContentIconHeight}"
                                Margin="{TemplateBinding VCardContentIconMargin}"
                                HorizontalAlignment="{TemplateBinding VCardContentIconHorizontalAlignment}"
                                VerticalAlignment="{TemplateBinding VCardContentIconVerticalAlignment}"
                                Data="{TemplateBinding VCardContentIcon}"
                                Foreground="{TemplateBinding VCardContentIconForeground}"
                                IsVisible="{TemplateBinding VIsCardContentIconVisible}" />

                            <!--  Content image  -->
                            <Image
                                x:Name="contentImage"
                                Width="{TemplateBinding VCardContentImageWidth}"
                                Height="{TemplateBinding VCardContentImageHeight}"
                                Margin="{TemplateBinding VCardContentImageMargin}"
                                HorizontalAlignment="{TemplateBinding VCardContentImageHorizontalAlignment}"
                                VerticalAlignment="{TemplateBinding VCardContentImageVerticalAlignment}"
                                IsVisible="{TemplateBinding VIsCardContentImageVisible}"
                                Source="{TemplateBinding VCardContentImage}" />

                            <!--  Icon desconectado  -->
                            <PathIcon
                                x:Name="deniedIcon"
                                Width="90"
                                Height="90"
                                Margin="{TemplateBinding VCardDeniedIconMargin}"
                                HorizontalAlignment="{TemplateBinding VCardDeniedIconHorizontalAlignment}"
                                VerticalAlignment="{TemplateBinding VCardDeniedIconVerticalAlignment}"
                                Data="{StaticResource denied}"
                                Foreground="#E20613"
                                IsVisible="False" />

                            <!--  Icon sem combustivel  -->
                            <PathIcon
                                x:Name="alertIcon"
                                Width="35.3"
                                Height="30.99"
                                Margin="{TemplateBinding VCardAlertIconMargin}"
                                HorizontalAlignment="{TemplateBinding VCardAlertIconHorizontalAlignment}"
                                VerticalAlignment="{TemplateBinding VCardAlertIconVerticalAlignment}"
                                Data="{StaticResource alert}"
                                Foreground="#FFD951"
                                IsVisible="False" />

                            <TextBlock
                                x:Name="contentText"
                                Grid.Row="1"
                                Margin="{TemplateBinding VCardContentTextMargin}"
                                HorizontalAlignment="{TemplateBinding VCardContentTextHorizontalAlignment}"
                                VerticalAlignment="{TemplateBinding VCardContentTextVerticalAlignment}"
                                FontSize="{TemplateBinding VCardContentTextFontSize}"
                                FontWeight="{TemplateBinding VCardContentTextFontWeight}"
                                Foreground="{TemplateBinding VCardContentTextForeground}"
                                LetterSpacing="-0.5"
                                Opacity="{TemplateBinding VCardContentTextOpacity}"
                                Text="{TemplateBinding VCardContentText}" />

                            <WrapPanel
                                Width="{TemplateBinding VCardStatusWidth}"
                                Margin="{TemplateBinding VCardStatusMargin}"
                                HorizontalAlignment="{TemplateBinding VCardStatusHorizontalAlignment}"
                                VerticalAlignment="{TemplateBinding VCardStatusVerticalAlignment}"
                                Orientation="Horizontal">
                                <Ellipse
                                    Width="{TemplateBinding VCardStatusEllipseWidth}"
                                    Height="{TemplateBinding VCardStatusEllipseHeight}"
                                    Margin="{TemplateBinding VCardStatusEllipseMargin}"
                                    HorizontalAlignment="{TemplateBinding VCardStatusEllipseHorizontalAlignment}"
                                    VerticalAlignment="{TemplateBinding VCardStatusEllipseVerticalAlignment}"
                                    Fill="{TemplateBinding VCardStatusEllipseBackground}" />

                                <TextBlock
                                    x:Name="statusText"
                                    Grid.Column="2"
                                    Margin="{TemplateBinding VCardStatusTextMargin}"
                                    HorizontalAlignment="{TemplateBinding VCardStatusTextHorizontalAlignment}"
                                    VerticalAlignment="{TemplateBinding VCardStatusTextVerticalAlignment}"
                                    FontSize="{TemplateBinding VCardStatusTextFontSize}"
                                    FontWeight="{TemplateBinding VCardStatusTextFontWeight}"
                                    Foreground="{TemplateBinding VCardStatusTextForeground}"
                                    LetterSpacing="-0.5"
                                    Text="{TemplateBinding VCardStatusText}"
                                    TextWrapping="Wrap" />
                            </WrapPanel>
                        </Grid>
                    </Border>

                </Border>

            </ControlTemplate>
        </Setter>
    </Style>

</Styles>