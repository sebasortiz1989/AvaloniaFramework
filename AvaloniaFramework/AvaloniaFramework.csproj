<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AvaloniaVersion>12.1.1</AvaloniaVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>AvaloniaFramework</RootNamespace>
    <AssemblyName>AvaloniaFramework</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Packing is an explicit `dotnet pack`, not a side effect of every build: now that consumers
      reference this project directly, pack-on-build would run on each of their builds too.
      Output goes to one configuration-independent folder so a Release pack does not land
      somewhere a consumer's local feed is not looking.
    -->
    <PackageOutputPath>$(MSBuildThisFileDirectory)../artifacts</PackageOutputPath>
    <PackageId>AvaloniaFramework</PackageId>
    <Version>1.0.0</Version>
    <Authors>Sebastian Ortiz</Authors>
    <Description>
      A small MVP/navigation framework for Avalonia: a dependency-injection container,
      a presenter lifecycle, a navigation controller, and a handful of styled controls.
    </Description>
    <PackageTags>avalonia;mvp;navigation;dependency-injection;controls</PackageTags>
    <RepositoryUrl>https://github.com/sebasortiz1989/AvaloniaFramework</RepositoryUrl>
    <PackageProjectUrl>https://github.com/sebasortiz1989/AvaloniaFramework</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Hosting\ShellView.axaml.cs">
      <DependentUpon>ShellView.axaml</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
