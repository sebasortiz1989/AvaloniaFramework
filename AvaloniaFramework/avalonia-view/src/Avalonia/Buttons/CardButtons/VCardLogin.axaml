<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:controls="using:AvaloniaFramework.Apresentacao.Buttons.CardButtons"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Design.PreviewWith>
        <controls:VCardLogin
            BorderBrush="Aqua"
            BorderThickness="4"
            BtForeground="Black"
            ButtonText="Test"
            CardIcon="{StaticResource checked}"
            CardIconForeground="Black"
            CardIconHeight="52"
            CardIconWidth="52"
            CornerRadius="20"
            Height="212"
            Width="188" />
    </Design.PreviewWith>

    <Styles.Resources>
        <StreamGeometry x:Key="checked">M8.23529 3.29412H16.4706C19.1995 3.29412 21.4118 5.50636 21.4118 8.23529V21.4118H8.23529C5.50636 21.4118 3.29412 19.1995 3.29412 16.4706V8.23529C3.29412 5.50636 5.50636 3.29412 8.23529 3.29412ZM0 8.23529C0 3.68707 3.68707 0 8.23529 0H16.4706C21.0188 0 24.7059 3.68707 24.7059 8.23529V21.4118V24.7059H21.4118H8.23529C3.68707 24.7059 0 21.0188 0 16.4706V8.23529ZM39.5294 0C34.9812 0 31.2941 3.68707 31.2941 8.23529V24.7059H47.7647C52.3129 24.7059 56 21.0188 56 16.4706V8.23529C56 3.68707 52.3129 0 47.7647 0H39.5294ZM0 39.5294C0 34.9812 3.68707 31.2941 8.23529 31.2941H24.7059V47.7647C24.7059 52.3129 21.0188 56 16.4706 56H8.23529C3.68707 56 0 52.3129 0 47.7647V39.5294ZM34.5882 34.5882H47.7647C50.4936 34.5882 52.7059 36.8005 52.7059 39.5294V47.7647C52.7059 50.4936 50.4936 52.7059 47.7647 52.7059H39.5294C36.8005 52.7059 34.5882 50.4936 34.5882 47.7647V34.5882ZM31.2941 31.2941H34.5882H47.7647C52.3129 31.2941 56 34.9812 56 39.5294V47.7647C56 52.3129 52.3129 56 47.7647 56H39.5294C34.9812 56 31.2941 52.3129 31.2941 47.7647V34.5882V31.2941Z</StreamGeometry>
    </Styles.Resources>
    <Style Selector="controls|VCardLogin">
        <Setter Property="Template">
            <ControlTemplate>
                <Button
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Command="{TemplateBinding Command}"
                    CommandParameter="{TemplateBinding CommandParameter}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Height="{TemplateBinding Height}"
                    Width="{TemplateBinding Width}"
                    x:Name="MainButton">

                    <Grid
                        Height="{TemplateBinding Height}"
                        HorizontalAlignment="Stretch"
                        RowDefinitions="0.75*, 0.25*"
                        VerticalAlignment="Stretch"
                        Width="{TemplateBinding Width}">
                        <Border Grid.Row="0" HorizontalAlignment="Center">
                            <PathIcon
                                Data="{TemplateBinding CardIcon}"
                                Foreground="White"
                                Height="{TemplateBinding CardIconHeight}"
                                Width="{TemplateBinding CardIconWidth}"
                                x:Name="MainIcon">
                                <PathIcon.Styles>
                                    <Style Selector="ToggleButton:checked PathIcon">
                                        <Setter Property="Foreground" Value="#040404" />
                                    </Style>
                                </PathIcon.Styles>
                            </PathIcon>
                        </Border>

                        <Border
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThicknessSquare}"
                            Grid.Row="1"
                            HorizontalAlignment="Stretch"
                            Width="{TemplateBinding Width}"
                            x:Name="Separator">
                            <Border.Styles>
                                <Style Selector="ToggleButton:checked Border">
                                    <Setter Property="BorderBrush" Value="#040404" />
                                </Style>
                            </Border.Styles>

                            <TextBlock
                                FontFamily="Roboto"
                                FontSize="{TemplateBinding FontSize}"
                                FontWeight="Bold"
                                Foreground="White"
                                HorizontalAlignment="Center"
                                Text="{TemplateBinding ButtonText}"
                                VerticalAlignment="Center"
                                x:Name="MainText" />
                        </Border>
                    </Grid>
                </Button>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>